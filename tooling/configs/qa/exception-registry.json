    {
      "id": "boundary.unsafe-windows-adapters",
      "ruleId": "security.unsafe-adapter",
      "classification": "architectural-boundary",
      "owner": "platform-owners",
      "exactScope": {
        "catalog": "tooling/configs/qa/unsafe-ffi-adapter-proof.json",
        "array": "adapters",
        "field": "path"
      },
      "rationale": "Raw Windows calls are confined to reviewed owner-local adapters with explicit RAII and shutdown proof.",
