        "docs/architecture/module-ownership.md",
        "docs/engineering/implementation-rules.md"
      ]
    },
    {
      "id": "boundary.bounded-control-waits",
      "ruleId": "architecture.hot-path-sleep",
      "classification": "architectural-boundary",
      "owner": "runtime-lifecycle",
      "exactScope": {
        "pathTerms": {
          "src/app/bridge/session/duplex/authenticated.rs": [
            "SESSION_MODE_EPOCH_POLL_INTERVAL"
          ],
          "src/app/bridge/windows_runtime.rs": [
            "PIPE_CONNECT_RETRY_DELAY"
          ],
          "src/app/resident/pipe_broker/duplex.rs": [
            "SESSION_BROKER_IDLE_POLL_INTERVAL"
          ],
          "src/app/resident/pipe_windows.rs": [
            "PIPE_ACCEPT_POLL_INTERVAL"
          ],
          "src/capture/wgc/windows/readback.rs": [
            "FRAME_WAIT_INTERVAL"
          ],
          "src/recording/runtime/windows_runtime/worker_loop.rs": [
            "RECORDING_IDLE_POLL_INTERVAL"
          ],
          "src/ipc/bridge/duplex.rs": [
            "BROWSER_EOF_RESPONSE_GRACE"
          ],
          "src/ipc/bridge/polling.rs": [
            "AGENT_RESPONSE_POLL_INTERVAL"
          ]
        }
      },
      "rationale": "These waits are named, bounded polling intervals owned by cancellable runtime loops.",
      "risk": "Unbounded or anonymous sleeps can hide deadlocks, latency, and missing shutdown ownership.",
      "proofReferences": [
        "docs/engineering/implementation-rules.md",
        "docs/engineering/testing-policy.md"
      ]
    },
    {
      "id": "boundary.recording-quality-policy-adapter",
      "ruleId": "architecture.owner-import",
      "classification": "architectural-boundary",
      "owner": "recording-settings-contract",
      "exactScope": {
        "exactEdges": [
          {
            "path": "src/recording/quality.rs",
            "owner": "recording",
            "imports": "settings"
